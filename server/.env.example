# Mercado Pago — get test credentials at:
# https://www.mercadopago.com.mx/developers/panel/app
MP_ACCESS_TOKEN=TEST-1234567890
# Webhook signing secret — dashboard → Notifications → Webhooks → Configure secret.
# Required in production (the server returns 503 without it). In dev it's optional;
# omit to bypass signature validation while testing locally.
MP_WEBHOOK_SECRET=

# Public URL where the frontend lives (for back_urls)
PUBLIC_BASE_URL=http://localhost:5173

# Override for MP back_url — MP rejects localhost, so in dev/test point this at
# your production domain or an ngrok tunnel (e.g. https://pixqui.cloud).
# Leave empty in production (falls back to PUBLIC_BASE_URL).
MP_BACK_URL=

# Email configuration — Brevo SMTP for free plan signups and admin notifications.
# Get your SMTP credentials at https://app.brevo.com/settings/smtp-api
EMAIL_FROM=PixquiCloud <noreply@pixqui.cloud>
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=your-brevo-smtp-login@smtp-brevo.com
EMAIL_PASS=your-brevo-smtp-key
ADMIN_EMAIL=hi@pixqui.cloud

# Server port
PORT=3000
