# Mercado Pago — get test credentials at:
# https://www.mercadopago.com.mx/developers/panel/app
MP_ACCESS_TOKEN=TEST-1234567890
# Webhook signing secret — dashboard → Notifications → Webhooks → Configure secret.
# Required in production (the server returns 503 without it). In dev it's optional;
# omit to bypass signature validation while testing locally.
MP_WEBHOOK_SECRET=

# Public URL where the frontend lives (for back_urls / Stripe success/cancel)
PUBLIC_BASE_URL=http://localhost:5173

# Server port
PORT=3000

# Stripe — get test credentials at https://dashboard.stripe.com (Test mode)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe Price IDs for each plan (recurring monthly MXN). Create products in dashboard.
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_FAMILIA=price_...
